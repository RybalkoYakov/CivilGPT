<UserControl x:Class="CivilGPT.UI.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="360">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="13"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   Text="CivilGPT — помощник геодезиста и проектировщика" />

        <TextBox Grid.Row="1"
                 x:Name="HistoryBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="4"
                 Background="#FFF8F8F8"
                 BorderBrush="#FFC8C8C8" />

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="PromptBox"
                     MinHeight="28"
                     Padding="4"
                     VerticalContentAlignment="Center"
                     KeyDown="PromptBox_KeyDown"
                     ToolTip="Опишите задачу. Enter — отправить, Shift+Enter — новая строка." />

            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Content="Отправить"
                    Width="90"
                    Margin="6,0,0,0"
                    Click="SendButton_Click" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="ClearButton"
                    Content="Очистить"
                    Width="80"
                    Click="ClearButton_Click" />
            <TextBlock x:Name="StatusText"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#FF606060" />
        </StackPanel>
    </Grid>
</UserControl>
