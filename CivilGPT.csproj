<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CivilGPT</AssemblyName>
    <RootNamespace>CivilGPT</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- Исходники в UTF-8 без BOM: без этого компилятор читает их в системной ANSI-кодировке
         и кириллица в строках превращается в кракозябры. -->
    <CodePage>65001</CodePage>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Ссылки на AutoCAD 2022 .NET API и Civil 3D 2022.
       ExcludeAssets="runtime": сборки нужны только для компиляции.
       Копировать их в папку плагина нельзя — Civil 3D должен использовать свои. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="24.1.51000" ExcludeAssets="runtime" />
    <PackageReference Include="Civil3D2022.Base" Version="1.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Только сборки .NET Framework: у плагина не должно быть сторонних
       NuGet-зависимостей, иначе срабатывает проблема привязки версий,
       которую в процессе AutoCAD невозможно исправить binding redirect.
       JSON реализован самостоятельно (Infrastructure/JsonHelper.cs). -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Штамп сборки: по нему видно, какая версия плагина реально загружена в AutoCAD.
       AutoCAD не перезагружает уже загруженную DLL, поэтому без штампа
       невозможно отличить свежую сборку от старой. -->
  <PropertyGroup>
    <BuildStamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildStamp>
    <InformationalVersion>$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <!-- TestDataset — тестовые чертежи и вспомогательные утилиты, в плагин не входят. -->
  <ItemGroup>
    <Compile Remove="TestDataset\**" />
    <None Remove="TestDataset\**" />
    <Page Remove="TestDataset\**" />
    <EmbeddedResource Remove="TestDataset\**" />
  </ItemGroup>

</Project>
